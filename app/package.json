{
  "name": "aria",
  "version": "0.1.4",
  "description": "Electron workspace UI with streamed Pi sessions.",
  "homepage": "https://github.com/Aaditri-GlobalTech/aria#Aria",
  "author": "Kumar Rahul Anand",
  "maintainer": "Aaditri GlobalTech",
  "license": "MIT",
  "desktopName": "aria",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "bun run typecheck && shx rm -rf dist && vite build && esbuild src/main/main.ts src/preload/preload.ts --bundle --platform=node --external:electron --format=cjs --outdir=dist --out-extension:.js=.cjs",
    "release:linux": "bun run build && electron-builder --linux AppImage deb --publish never",
    "release:windows": "bun run build && electron-builder --win nsis --publish never",
    "start": "electron .",
    "test": "vitest run",
    "check:browser-smoke": "node scripts/check-browser-smoke.mjs",
    "typecheck": "tsgo --noEmit",
    "check": "biome check src scripts test package.json tsconfig.json vite.config.ts",
    "lint": "biome check --write ."
  },
  "dependencies": {
    "@aria/extension-agent": "workspace:*",
    "@aria/extension-workspace": "workspace:*",
    "@aria/protocol": "workspace:*",
    "@kobalte/core": "0.13.13",
    "@vscode/codicons": "0.0.46-24",
    "mermaid": "11.17.2",
    "shiki": "4.4.3",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jiti": "2.7.0",
    "shx": "0.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "com.aaditri.aria",
    "productName": "Aria",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/host",
        "to": "host"
      },
      {
        "from": "resources/extensions",
        "to": "extensions"
      }
    ],
    "linux": {
      "category": "Utility",
      "maintainer": "Aaditri GlobalTech",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    }
  }
}
